[Unit]
Description=BVG Tram Departure Collector
Documentation=https://github.com/htw-IIW/NoSQL
# Start after networking and Docker are up
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=__USER__
WorkingDirectory=__REPO_DIR__

# Full path to the conda-env Python — set by install_services.sh
ExecStart=__PYTHON__ -m src.collector.collect_departures

# Write stdout + stderr to the same log the bash scripts use
StandardOutput=append:__REPO_DIR__/logs/collector.log
StandardError=append:__REPO_DIR__/logs/collector.log

# Restart automatically after a crash; wait 30s between attempts
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
