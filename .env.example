# Vorlage für die Zugangsdaten. Kopieren und ausfüllen:
#
#     cp .env.example .env
#
# .env steht in .gitignore und darf niemals eingecheckt werden.
# Auf dem Raspberry Pi muss dieselbe Datei im Repo-Root liegen — die
# systemd-Units lesen sie über EnvironmentFile (siehe PI_setup.md).

# Elasticsearch-Endpunkt. Lokal http://localhost:9200, vom Laptop aus
# über Tailscale http://tram-pi:9200
ES_HOST=http://tram-pi:9200

# Superuser des Clusters. Wird von Collector, Notebooks und Skripten benutzt.
ES_USER=elastic
ES_PASSWORD=

# Passwort des internen Kibana-Dienstkontos (kibana_system).
# Nur von docker-compose.yml gebraucht, nicht vom Python-Code.
KIBANA_SYSTEM_PASSWORD=
